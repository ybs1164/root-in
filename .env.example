# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 http://localhost:5188 과 배포 도메인을 등록해야 동작합니다.
# 비워두면 MapLibre(OpenStreetMap) + Photon 검색으로 대체됩니다.
VITE_KAKAO_JS_KEY=

# Supabase 프로젝트 > Project Settings > API 의 Project URL 과 anon(public) 키.
# 비워두면 로그인 없이 지금처럼 이 기기에만 저장합니다. service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
