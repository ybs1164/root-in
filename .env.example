# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 http://localhost:5188 과 배포 도메인을 등록해야 동작합니다.
# 비워두면 MapLibre(OpenStreetMap) + Photon 검색으로 대체됩니다.
VITE_KAKAO_JS_KEY=

# Supabase 프로젝트 > Project Settings > API 의 Project URL 과 anon(public) 키.
# 비워두면 로그인 없이 지금처럼 이 기기에만 저장합니다. service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 새 공개 키(sb_publishable_...)를 쓰면 ANON_KEY 대신 아래 값을 설정합니다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# PostHog 프로젝트 API 키(phc_…)와 호스트(기본 https://us.i.posthog.com). 비워두면 아무것도 보내지 않습니다.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# We Now 그룹을 카카오 로그인한 사람만 쓰게 하려면 true. 비워 두면(테스트용 기본값)
# 로그인 없이 기기마다 게스트 계정을 만들어 씁니다(Supabase 익명 로그인을 켜야 함).
VITE_GROUPS_NEED_LOGIN=

# 지도 데이터 묶음(scripts/publish-map-data.mjs로 만든 korea-<날짜>/ 폴더)을 올린 주소.
# 지금 올린 곳: https://ybs1164.github.io/root-in-map-data/korea-20261022/ — 비워 두면 이 앱의 public/korea/를 그대로 씁니다.
# 다른 출처라 그 서버가 CORS로 앱 주소(웹 주소, 안드로이드 https://localhost)를 허용해야 합니다.
VITE_MAP_DATA_URL=

# 공유·초대 링크가 가리킬 웹 앱 주소(예: https://root-in.pages.dev/). 안드로이드 앱은 페이지 주소가
# https://localhost라 이 값이 없으면 링크가 받는 사람 폰에서 열리지 않습니다. 비워 두면 지금 페이지 주소를 씁니다.
VITE_PUBLIC_APP_URL=
